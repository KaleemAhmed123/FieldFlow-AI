{
  "$defs": {
    "CardAction": {
      "description": "A suggested action chip on a card (slice 2). `type` maps to a real RCS suggested action:\nshare_location (customer sends GPS), dial (call a number), calendar (add the appointment),\nview (open a URL). `value` carries the phone/url/label the action needs; blank where unused.",
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "default": "",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "label"
      ],
      "title": "CardAction",
      "type": "object"
    },
    "SlotOption": {
      "properties": {
        "slotId": {
          "title": "Slotid",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "technician": {
          "title": "Technician",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "slotId",
        "label",
        "technician"
      ],
      "title": "SlotOption",
      "type": "object"
    }
  },
  "description": "A minimal RCS-card-ish payload. FakeVonage 'sends' this; real Vonage renders it later.",
  "properties": {
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "body": {
      "default": "",
      "title": "Body",
      "type": "string"
    },
    "options": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SlotOption"
      },
      "title": "Options",
      "type": "array"
    },
    "actions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CardAction"
      },
      "title": "Actions",
      "type": "array"
    },
    "payUrl": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payurl"
    },
    "version": {
      "default": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "kind",
    "title"
  ],
  "title": "Card",
  "type": "object"
}