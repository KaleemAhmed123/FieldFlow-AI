# Copy to .env for local dev. Validated at boot (pydantic-settings) — fail fast if wrong.
# Managed free tiers mean NO Docker is needed for dev.
APP_ENV=local
LOG_LEVEL=INFO

# --- Database: Supabase (Postgres + pgvector) ---
# Use the SESSION POOLER connection string (port 5432) + the +asyncpg driver.
# (The transaction pooler on 6543 breaks asyncpg prepared statements — avoid it.)
# In Supabase: enable the `vector` extension for RAG later.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local fallback (no infra): a SQLite file
# DATABASE_URL=sqlite+aiosqlite:///./fieldflow_dev.db

# --- Queue: CloudAMQP (free "Little Lemur" plan) ---
RABBITMQ_URL=amqps://<user>:<password>@<host>.rmq.cloudamqp.com/<vhost>
# Local fallback (Docker):
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- Control panel origin (CORS) ---
PANEL_ORIGIN=http://localhost:5173

# --- LLM: one switch, two providers (wired in build step 5) ---
LLM_PROVIDER=groq                       # groq | gemini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- RAG: Jina embeddings + reranker (build step 4). Free tier at jina.ai. ---
# Blank → the live pgvector knowledge store is unavailable; tests use the in-memory fake.
JINA_API_KEY=
JINA_MODEL=jina-embeddings-v3
JINA_RERANKER=jina-reranker-v1-base-en
EMBEDDING_DIM=1024
RETRIEVAL_K=3

# --- Observability: Logfire (live god-eye tracing). Leave blank to run without it. ---
LOGFIRE_TOKEN=

# --- Later layers (not used yet; listed so the file is ready) ---
# NOTE: inbound webhooks are SKIPPED for the POC (speed). We fire events via /sim instead.
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# VONAGE_APPLICATION_ID=
# VONAGE_RCS_AGENT_ID=
# SALESFORCE_MCP_URL=
# SALESFORCE_MCP_TOKEN=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
