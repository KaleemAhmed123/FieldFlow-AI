# Copy to .env for local dev. Validated at boot (pydantic-settings) — fail fast if wrong.
APP_ENV=local
LOG_LEVEL=INFO

# Postgres (from infra/docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://fieldflow:fieldflow@localhost:5432/fieldflow

# RabbitMQ (from infra/docker-compose.yml)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Where the control panel runs (CORS)
PANEL_ORIGIN=http://localhost:5173

# --- not used in the walking skeleton, here for when we wire the real services ---
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
