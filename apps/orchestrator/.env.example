# Copy to .env for local dev. Validated at boot (pydantic-settings) — fail fast if wrong.
# Managed free tiers mean NO Docker is needed for dev.
APP_ENV=local
LOG_LEVEL=INFO

# --- Database: Supabase (Postgres + pgvector) ---
# Use the SESSION POOLER connection string (port 5432) + the +asyncpg driver.
# (The transaction pooler on 6543 breaks asyncpg prepared statements — avoid it.)
# In Supabase: enable the `vector` extension for RAG later.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local fallback (no infra): a SQLite file
# DATABASE_URL=sqlite+aiosqlite:///./fieldflow_dev.db

# --- Queue: CloudAMQP (free "Little Lemur" plan) ---
RABBITMQ_URL=amqps://<user>:<password>@<host>.rmq.cloudamqp.com/<vhost>
# Local fallback (Docker):
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- Control panel origin (CORS) ---
PANEL_ORIGIN=http://localhost:5173

# --- LLM proposer: fixed ladder Groq -> Gemini -> deterministic (build step 5) ---
# A provider is live only if its key is set. Blank BOTH keys → the deterministic proposer runs
# (fully offline). No LLM_PROVIDER switch: the ladder order is fixed (Groq primary, Gemini is a
# different-provider fallback so a Groq outage/rate-limit doesn't take us down).
# Model availability drifts on free tiers - verify per account with the SDK's .models.list().
# (The originally-planned llama-3.3-70b-versatile and gemini-2.5-flash were both gone by 2026-10-08.)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# LLM call tuning (all optional; defaults shown):
LLM_TEMPERATURE=0.2
LLM_TOP_P=1.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=1

# --- Evidence-weighted confidence (all tunable; the calibration test is the contract) ---
# confidence = Σ(factor × weight), clamped [0,1]. Weights default to summing 1.0.
CONF_W_PRIOR=0.40        # reason difficulty (dominant, so good jobs auto-send)
CONF_W_HEADROOM=0.20     # how much legal room policy left (APPROVED/PARTIAL/DENIED)
CONF_W_GROUNDING=0.15    # strength of the retrieved knowledge (RAG)
CONF_W_DATA=0.10         # fraction of key case fields present
CONF_W_LLM=0.15          # the LLM's own rating (clamped: can only lower, never inflate)
CONF_THRESHOLD=0.7       # below this → human approval (NFR-4)
CONF_GROUNDING_FULL=0.6  # a retrieval score at/above this counts as "fully grounded"
# Hard human-review floor (risk-tiering): these reasons go to a human at ANY confidence.
ALWAYS_HUMAN_REASONS=safety_risk,warranty_dispute

# --- RAG: Jina embeddings + reranker (build step 4). Free tier at jina.ai. ---
# Blank → the live pgvector knowledge store is unavailable; tests use the in-memory fake.
JINA_API_KEY=
JINA_MODEL=jina-embeddings-v3
JINA_RERANKER=jina-reranker-v1-base-en
EMBEDDING_DIM=1024
RETRIEVAL_K=3

# --- Commerce + Razorpay Test-Mode (build step 6) ---
# Blank keys → FakeRazorpay (offline; all tests + a keyless run use it). Copy your TEST keys here
# only for the gated live test-mode payment. Money is integer PAISE (₹1 = 100 paise), never float.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
COMMERCE_CURRENCY=INR
COMMERCE_LABOUR_PAISE=50000        # ₹500 labour on every chargeable quote
COMMERCE_HIGH_VALUE_PAISE=500000   # quotes ≥ ₹5,000 route to a human (risk-tiering)

# --- Observability: Logfire (live god-eye tracing). Leave blank to run without it. ---
LOGFIRE_TOKEN=

# --- Vonage RCS: real send + real inbound/status webhooks (build step 9b) ---
# Blank → FakeVonage (offline default; all tests use it). The real send is ARMED only when
# APPLICATION_ID + PRIVATE_KEY_PATH + AGENT_ID + TEST_TO are ALL set — so creds can sit here during
# offline dev without a billed send firing. $100 credit: one send per manual demo, never in a loop.
# Send auth = a short-lived JWT (RS256) signed with the application's private key — RCS senders are
# tied to an application, so api_key/secret (Basic) can't authenticate an RCS send. The SIGNATURE
# SECRET (dashboard Settings) is a DIFFERENT secret that verifies inbound webhooks (HMAC-SHA256).
VONAGE_API_KEY=                   # legacy; not used for the RCS send (JWT is). Keep for other APIs.
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=            # the Vonage application id the JWT is signed for
VONAGE_PRIVATE_KEY_PATH=          # path to that app's private.key, e.g. app/resources/private.key
VONAGE_RCS_AGENT_ID=              # the `from` sender, e.g. astrea_it
VONAGE_TEST_TO=                   # test device number, DIGITS ONLY, no + (e.g. 916394493446)
VONAGE_SIGNATURE_SECRET=          # from dashboard Settings; blank → inbound signature check skipped
# VONAGE_MESSAGES_URL=https://api.nexmo.com/v1/messages   # override only if your region differs

# --- Later layers (not used yet; listed so the file is ready) ---
# SALESFORCE_MCP_URL=
# SALESFORCE_MCP_TOKEN=
