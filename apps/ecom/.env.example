# Copy to .env.local and fill from Supabase dashboard -> Settings -> API.
# Only the e-com service holds these; the orchestrator talks to e-com over HTTP, never Supabase.

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# service_role key (SERVER-SIDE ONLY — never ship to the browser). Lets the API seed + edit stock.
SUPABASE_SERVICE_ROLE_KEY=
